# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
# Model used by the eval LLM judge (defaults to AGENT_MODEL)
JUDGE_MODEL=
# How long a policy snapshot is reused before a fresh live fetch
POLICY_CACHE_TTL_HOURS=6
# Where the mock TestAir site runs
TESTAIR_BASE_URL=http://127.0.0.1:8001
# SQLite file for policy snapshots and change events
POLICY_DB_PATH=data/policy_snapshots.db
# Optional global failure switch for the mock site, e.g. "captcha=1" or "error=500"
TESTAIR_FAILURE=
POLICY_MIN_INTERVAL_S=8
# 1 = render policy pages headless (some CDNs block headless browsers)
POLICY_BROWSER_HEADLESS=0
# Live IndiGo booking source: attach (assisted capture from your own Chrome) | auto
LIVE_INDIGO_MODE=attach
CHROME_CDP_URL=http://127.0.0.1:9222

# Which AI provider runs the agent: gemini | anthropic (auto-detected from the key present if unset)
AGENT_PROVIDER=gemini
GEMINI_API_KEY=
# Gemini model id (leave empty for the default)
GEMINI_MODEL=
