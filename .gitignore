# --- secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key

# --- local environment / caches ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# --- runtime data (re-created automatically) ---
data/

# Persistent browser profile for the live IndiGo source (contains cookies)
.browser_profile/

# Generated test e-tickets (regenerate with scripts/make_test_etickets.py)
tests/fixtures/etickets/*.pdf

# Live booking captures: only REDACTED files may ever be committed
tests/fixtures/live/*
!tests/fixtures/live/*.redacted.json
tests/fixtures/live_raw/

# Evaluation scratch output (reports in eval/results/*.md|json are kept)
eval/results/run_log.txt
eval/results/progress_*.json
# Reports from runs broken by quota/network failures (kept locally, not published)
eval/results/invalid/
